<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- README.md 필수 권한 6종 + 부팅 재시작 -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- v2: 다른 앱 위 바텀시트 팝업 (거부 시 헤드업 알림 폴백) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- v3: GitHub Releases 업데이트 확인·다운로드 + 설치 화면 호출 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- API 30 이하에서 페어링 기기 목록 조회용 (31+는 BLUETOOTH_CONNECT로 대체) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Eottadwotji">

        <!-- 앱 아이콘 변경: 런처 진입점은 전부 alias — MainActivity 자체는 항상 활성이라
             알림/위젯 PendingIntent가 아이콘 변경과 무관하게 동작한다 -->
        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <activity-alias
            android:name=".IconDefault"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_kei_white"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_kei_white"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_kei_black"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_kei_black"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_kei_gray"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_kei_gray"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_sedan_white"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_sedan_white"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_sedan_black"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_sedan_black"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_sedan_gray"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_sedan_gray"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_suv_white"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_suv_white"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_suv_black"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_suv_black"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_suv_gray"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_suv_gray"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_sports_white"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_sports_white"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_sports_black"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_sports_black"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_sports_gray"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_sports_gray"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 층 선택 바텀시트: 감지 오버레이 / 알림 폴백 / 수동 기록 / 위젯 공용 진입점 -->
        <activity
            android:name=".ui.floorpicker.FloorPickerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Eottadwotji.Sheet" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.history.HistoryActivity"
            android:exported="false" />

        <service
            android:name=".detection.ParkingDetectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- 매니페스트 등록은 백업 경로 — API 33+ 제한 대응으로 서비스 안에서 동적 등록 이중화 (README) -->
        <receiver
            android:name=".detection.CarBluetoothReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".detection.FloorSelectedReceiver"
            android:exported="false" />

        <!-- 재부팅 후 감지 서비스 재기동 (온보딩 완료 시에만) -->
        <receiver
            android:name=".detection.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- v2: 홈 위젯 2종 (Glance) — 주차 상태 변경 시에만 push 갱신 -->
        <receiver
            android:name=".ui.widget.PillWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_pill_info" />
        </receiver>
        <receiver
            android:name=".ui.widget.GaugeWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_gauge_info" />
        </receiver>

        <!-- 주차 사진 저장용 (카메라 촬영 결과) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.eottadwotji.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
