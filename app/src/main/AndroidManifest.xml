<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- README.md 필수 권한 6종 + 부팅 재시작 -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- v2: 다른 앱 위 바텀시트 팝업 (거부 시 헤드업 알림 폴백) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- v3: GitHub Releases 업데이트 확인·다운로드 + 설치 화면 호출 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- v4.2: 대시보드 지도 타일(osmdroid) 네트워크 상태 확인용 (일반 권한) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- API 30 이하에서 페어링 기기 목록 조회용 (31+는 BLUETOOTH_CONNECT로 대체) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Eottadwotji">

        <!-- 앱 아이콘 변경: 런처 진입점은 전부 alias — MainActivity 자체는 항상 활성이라
             알림/위젯 PendingIntent가 아이콘 변경과 무관하게 동작한다 -->
        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <activity-alias
            android:name=".IconDefault"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_kei_white"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_kei_white"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_kei_black"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_kei_black"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_kei_gray"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_kei_gray"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_sedan_white"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_sedan_white"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_sedan_black"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_sedan_black"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_sedan_gray"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_sedan_gray"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_suv_white"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_suv_white"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_suv_black"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_suv_black"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_suv_gray"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_suv_gray"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_sports_white"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_sports_white"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_sports_black"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_sports_black"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_sports_gray"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_sports_gray"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 층 선택 바텀시트: 감지 오버레이 / 알림 폴백 / 수동 기록 / 위젯 공용 진입점 -->
        <activity
            android:name=".ui.floorpicker.FloorPickerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Eottadwotji.Sheet" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.history.HistoryActivity"
            android:exported="false" />

        <service
            android:name=".detection.ParkingDetectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- 차량 BT 감지의 유일한 상시 경로 (대기 중엔 서비스가 없다 — v3.6 수명 정책).
             exported="true"가 필수: ACL 브로드캐스트는 system_server(uid 1000)가 아니라
             블루투스 스택 프로세스(uid bluetooth)가 보내므로, exported="false"면 AMS가
             "is not exported from uid" 로 걸러 버려 리시버가 영영 깨어나지 않는다 (v4.2 수정).
             ACL_CONNECTED/DISCONNECTED는 protected-broadcast라 다른 앱이 위조할 수 없어 안전. -->
        <receiver
            android:name=".detection.CarBluetoothReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".detection.FloorSelectedReceiver"
            android:exported="false" />

        <!-- 재부팅·앱 업데이트 직후 주차 캡슐 복원 (v3.9.5) -->
        <receiver
            android:name=".detection.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- v5.1: 위젯 분 틱 — 주차 중에만 1분 간격 부정확 알람으로 경과시간(H:MM) 갱신 -->
        <receiver
            android:name=".ui.widget.WidgetTickReceiver"
            android:exported="false" />

        <!-- v2: 홈 위젯 2종 (Glance) — 주차 상태 변경 + 분 틱 때 갱신 -->
        <receiver
            android:name=".ui.widget.PillWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_pill_info" />
        </receiver>
        <receiver
            android:name=".ui.widget.GaugeWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_gauge_info" />
        </receiver>

        <!-- 주차 사진 저장용 (카메라 촬영 결과) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.eottadwotji.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
